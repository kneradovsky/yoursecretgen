# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
# Get it from: https://analytics.google.com/analytics/web/ → Admin → Data Streams → Web
VITE_GA_MEASUREMENT_ID=

# Public site URL used in SEO tags (canonical, Open Graph, hreflang), robots.txt
# and sitemap.xml. No trailing slash. Required for `npm run build` and for the
# SEO/prerender scripts.
VITE_SITE_URL=https://mylocaltools.dev

# Language served on unprefixed routes: en (default) or ru. Also decides which
# pages prerender.js and generate-seo-files.mjs treat as the default language,
# so it must match the deployed content. Required only if not 'en'.
# VITE_DEFAULT_LANG=en
